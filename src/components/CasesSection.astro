---
import type { CaseContent } from "@/lib/content/types";
import FallbackImage from "./FallbackImage.astro";
import SectionShell from "./SectionShell.astro";

interface Props {
    title: string;
    subtitle: string;
    diagnosisLabel: string;
    emptyLabel: string;
    viewAllLabel?: string;
    viewAllHref?: string;
    items: CaseContent[];
}

const {
    title,
    subtitle,
    diagnosisLabel,
    emptyLabel,
    viewAllLabel,
    viewAllHref,
    items,
} = Astro.props;
---

<SectionShell
    id="casos"
    title={title}
    subtitle={subtitle}
    actionHref={viewAllHref}
    actionLabel={viewAllLabel}
>
    {
        items.length === 0 ? (
            <p class="mt-6 text-sm text-zinc-600 dark:text-violet-300">
                {emptyLabel}
            </p>
        ) : null
    }
    <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {
            items.map((item) => (
                <article class="glass-panel overflow-hidden rounded-2xl border transition-all duration-300 hover:-translate-y-0.5">
                    <FallbackImage
                        src={item.imageUrl}
                        alt={item.title}
                        class="block h-48 w-full object-cover"
                    />
                    <div class="space-y-2 p-4">
                        <h3 class="text-lg font-semibold">{item.title}</h3>
                        <p class="text-zinc-600 dark:text-violet-300">
                            {item.description}
                        </p>
                        <p class="text-sm text-zinc-600 dark:text-violet-400">
                            <strong>{diagnosisLabel}:</strong>{" "}
                            {item.diagnosis || "-"}
                        </p>
                    </div>
                </article>
            ))
        }
    </div>
</SectionShell>
