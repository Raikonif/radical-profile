---
import type { Lang, SchemaItem } from "../data/siteContent";
import FallbackImage from "./FallbackImage.astro";
import SectionShell from "./SectionShell.astro";

interface Props {
    lang: Lang;
    title: string;
    subtitle: string;
    items: SchemaItem[];
}

const { lang, title, subtitle, items } = Astro.props;
const t = <T extends Record<Lang, string>>(entry: T) => entry[lang];
---

<SectionShell id="esquemas" title={title} subtitle={subtitle}>
    <div class="mt-6 grid gap-4 lg:grid-cols-2">
        {
            items.map((item) => (
                <article class="glass-panel overflow-hidden rounded-2xl border transition-all duration-300 hover:-translate-y-0.5">
                    <FallbackImage
                        src={item.image}
                        alt={t(item.title)}
                        class="block h-48 w-full object-cover"
                    />
                    <div class="space-y-2 p-4">
                        <h3 class="text-lg font-semibold">{t(item.title)}</h3>
                        <p class="text-zinc-600 dark:text-violet-300">
                            {t(item.description)}
                        </p>
                    </div>
                </article>
            ))
        }
    </div>
</SectionShell>
