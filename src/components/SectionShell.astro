---
interface Props {
    id: string;
    title: string;
    subtitle: string;
    actionHref?: string;
    actionLabel?: string;
}

const { id, title, subtitle, actionHref, actionLabel } = Astro.props;
---

<section class="py-10" id={id}>
    <div
        class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between"
    >
        <div>
            <h2 class="text-2xl font-semibold md:text-4xl">{title}</h2>
            <p class="mt-2 text-zinc-600 dark:text-violet-300">{subtitle}</p>
        </div>
        {
            actionHref && actionLabel ? (
                <a
                    href={actionHref}
                    class="inline-flex items-center rounded-full border border-violet-400/30 bg-white/70 px-4 py-2 text-sm font-medium text-violet-700 transition hover:border-violet-500/50 hover:text-violet-900 dark:border-violet-300/20 dark:bg-violet-950/40 dark:text-violet-200 dark:hover:text-violet-100"
                >
                    {actionLabel}
                </a>
            ) : null
        }
    </div>
    <slot />
</section>
