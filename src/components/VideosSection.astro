---
import type { VideoContent } from "@/lib/content/types";
import SectionShell from "./SectionShell.astro";

interface Props {
    title: string;
    subtitle: string;
    emptyLabel: string;
    openLabel: string;
    viewAllLabel?: string;
    viewAllHref?: string;
    items: VideoContent[];
}

const {
    title,
    subtitle,
    emptyLabel,
    openLabel,
    viewAllLabel,
    viewAllHref,
    items,
} = Astro.props;
---

<SectionShell
    id="videos"
    title={title}
    subtitle={subtitle}
    actionHref={viewAllHref}
    actionLabel={viewAllLabel}
>
    {
        items.length === 0 ? (
            <p class="mt-6 text-sm text-zinc-600 dark:text-violet-300">
                {emptyLabel}
            </p>
        ) : null
    }
    <div class="mt-6 grid gap-4 lg:grid-cols-2">
        {
            items.map((video) => (
                <article class="glass-panel rounded-2xl border transition-all duration-300 hover:-translate-y-0.5">
                    <div class="space-y-2 p-4">
                        <h3 class="text-lg font-semibold">{video.name}</h3>
                        <p class="text-zinc-600 dark:text-violet-300">
                            {video.description}
                        </p>
                        {video.fileUrl ? (
                            <a
                                href={video.fileUrl}
                                target="_blank"
                                rel="noreferrer"
                                class="inline-flex rounded-full border border-indigo-400/30 bg-indigo-500/10 px-3 py-1.5 text-xs font-medium text-indigo-700 transition hover:border-indigo-500/50 dark:text-indigo-200"
                            >
                                {openLabel}
                            </a>
                        ) : null}
                    </div>
                </article>
            ))
        }
    </div>
</SectionShell>
